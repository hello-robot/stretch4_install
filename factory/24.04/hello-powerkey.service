[Unit]
Description=Power key: power off 10 s after a press, a second press cancels

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=handle-power-key --who=hello-powerkey --why="power key counts down 10 s" --mode=block /usr/bin/python3 -u /usr/local/sbin/hello_powerkey.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
