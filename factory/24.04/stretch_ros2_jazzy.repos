repositories:
  stretch4_ros2:
    type: git
    url: https://github.com/hello-robot/stretch4_ros2
    version: jazzy
  stretch4_web_teleop:
    type: git
    url: https://github.com/hello-robot/stretch4_web_teleop
    version: main
  ros2_numpy:
    type: git
    url: https://github.com/hello-robot/ros2_numpy
    version: jazzy
  HesaiLidar_ROS_2.0:
    type: git
